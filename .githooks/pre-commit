#!/bin/sh
# Pre-commit hook: when any manuscript's TeX source or bibliography is
# staged, rebuild all manuscript PDFs and stage the results so committed
# PDFs always match the committed sources.
set -e

SRC_CHANGED=$(git diff --cached --name-only | grep -E '^manuscripts/[^/]+/[^/]+\.(tex|bib)$' || true)
[ -z "$SRC_CHANGED" ] && exit 0

echo "[pre-commit] Manuscript source staged — rebuilding..."
make papers >/dev/null
git add manuscripts/*/*.pdf
echo "[pre-commit] Manuscript PDFs rebuilt and staged."
